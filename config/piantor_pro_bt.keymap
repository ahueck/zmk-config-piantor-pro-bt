#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Port of the QMK keymap in qmk-template/keymap.c to the 42-key Piantor Pro BT.
 *
 * - The QMK number row is not present and is not emulated. Digits live on the
 *   NUM layer's keypad, and F1-F12 live on the FUN layer (Miryoku-style split).
 * - The QMK STD/gaming and POINTER layers are dropped (no pointing device).
 * - QMK layer names: QWERTY -> BASE, SYMB -> SYM, SYMB_EXT -> NUM + FUN,
 *   ADJUST -> ADJUST (merged with the ZMK bluetooth/RGB/system keys).
 * - QMK custom macros (ASC_*, SEL*, M_*, DM_*) are not ported; their positions
 *   are &none.
 *
 * Timing from qmk-template/config.h:
 *   TAPPING_TERM 200   -> tapping-term-ms = <200>
 *   FLOW_TAP_TERM 150  -> require-prior-idle-ms = <150>
 *   QUICK_TAP_TERM 200 -> quick-tap-ms = <200>
 *   PERMISSIVE_HOLD    -> flavor = "balanced"
 *   CHORDAL_HOLD       -> hold-trigger-key-positions + hold-trigger-on-release
 *   SPECULATIVE_HOLD   -> hold-while-undecided (Shift/Ctrl home-row mods only)
 */

#define BASE   0
#define SYM    1
#define NUM    2
#define FUN    3
#define ADJUST 4

/* Key positions per hand, including the thumb keys. */
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41

/* Helper macros for home-row hold-tap behaviors. */
#define MAKE_HRM_EX(NAME, HOLD, TAP, TRIGGER_POS, EXTRA) \
    NAME: NAME {                                         \
        compatible = "zmk,behavior-hold-tap";            \
        #binding-cells = <2>;                            \
        flavor = "balanced";                             \
        tapping-term-ms = <200>;                         \
        quick-tap-ms = <200>;                            \
        require-prior-idle-ms = <150>;                   \
        hold-trigger-key-positions = <TRIGGER_POS>;      \
        hold-trigger-on-release;                         \
        bindings = <HOLD>, <TAP>;                        \
        EXTRA                                            \
    };
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    MAKE_HRM_EX(NAME, HOLD, TAP, TRIGGER_POS, )

/* Shorthand keycode aliases. */
#define ___      &trans
#define XXX      &none

/* Home-row mods & G/H layer-taps. */
#define A_GUI    &hml_ag LGUI A
#define S_ALT    &hml_ag LALT S
#define D_SFT    &hml_sc LSHIFT D
#define F_CTL    &hml_sc LCTRL F
#define G_SYM    &hml_lt SYM G
#define H_SYM    &hmr_lt SYM H
#define J_CTL    &hmr_sc RCTRL J
#define K_SFT    &hmr_sc RSHIFT K
#define L_ALT    &hmr_ag RALT L
#define SCLN_GUI &hmr_ag RGUI SEMI
#define SQT_CTL  &hmr_sc RCTRL SQT
#define BSLH_SFT &hmr_sc RSHIFT BSLH

/* Thumb layer-taps. */
#define BSPC_SYM &tlt SYM BSPC
#define DEL_NUM  &tlt NUM DEL
#define RET_FUN  &tlt FUN RET
#define SPC_SYM  &tlt SYM SPACE
#define RCTL_ADJ &tlt ADJUST RCTRL

/* Combined-modifier taps (QMK CTME/CTSH/CTAL). */
#define CTME     &mm LC(LG(LCTRL)) GRAVE
#define CTSH     &mm LC(LS(LCTRL)) KP_MINUS
#define CTAL     &mm LC(LA(LCTRL)) KP_PLUS
#define LSHPRCNT &mt LSHIFT PRCNT

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        /*
         * Home-row mods & G/H layer-taps. Hold triggers only on the opposite
         * hand. Shift/Ctrl home-row mods also use QMK SPECULATIVE_HOLD
         * (hold-while-undecided).
         */
        MAKE_HRM(hml_ag, &kp, &kp, KEYS_R)
        MAKE_HRM_EX(hml_sc, &kp, &kp, KEYS_R, hold-while-undecided;)
        MAKE_HRM(hmr_ag, &kp, &kp, KEYS_L)
        MAKE_HRM_EX(hmr_sc, &kp, &kp, KEYS_L, hold-while-undecided;)
        MAKE_HRM(hml_lt, &mo, &kp, KEYS_R)
        MAKE_HRM(hmr_lt, &mo, &kp, KEYS_L)

        /*
         * Thumb layer-taps. No positional restriction: ADJUST is only reachable
         * from one thumb and must work with both hands, and the SYM/NUM/FUN
         * thumbs should work with the same-hand keys as well.
         */
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        /* QMK CTME/CTSH/CTAL: combined-modifier holds, keycode taps. */
        mm: multi_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            // -------------------------------------------------------------------   -------------------------------------------------------------------
            // |   ESC    |    Q     |    W     |    E     |    R     |    T     |   |    Y     |    U     |    I     |    O     |    P     |   CAPS   |
            // |   TAB    |  A/GUI   |  S/ALT   |  D/SFT   |  F/CTL   |  G/SYM   |   |  H/SYM   |  J/CTL   |  K/SFT   |  L/ALT   |  ;/GUI   |  '/CTL   |
            // |   LSFT   |    Z     |    X     |    C     |    V     |    B     |   |    N     |    M     |    ,     |    .     |    /     |  \/SFT   |
            // ---------------------------------|   CTL    | BSPC/SYM | DEL/NUM  |   | ENT/FUN  | SPC/SYM  | RCTL/ADJ |---------------------------------
            //                                  ----------------------------------   ----------------------------------
            bindings = <
            // ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                 &kp ESC          &kp Q            &kp W            &kp E            &kp R            &kp T                &kp Y            &kp U            &kp I            &kp O            &kp P            &caps_word
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 &kp TAB          A_GUI            S_ALT            D_SFT            F_CTL            G_SYM                H_SYM            J_CTL            K_SFT            L_ALT            SCLN_GUI         SQT_CTL
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 &kp LSHIFT       &kp Z            &kp X            &kp C            &kp V            &kp B                &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         BSLH_SFT
            // ╰──────────────────────────────────────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼──────────────────────────────────────────────────╯
                                                                    &kp LCTRL        BSPC_SYM         DEL_NUM              RET_FUN          SPC_SYM          RCTL_ADJ
            //                                                    ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
            >;
        };

        sym_layer {
            display-name = "SYMBOL";
            // -------------------------------------------------------------------   -------------------------------------------------------------------
            // |     !    | `/C+GUI  |    ~     |    #     |    (     |    )     |   |    T     |   HOME   |   PGDN   |   PGUP   |   END    |    ^     |
            // |     @    | -/C+SFT  |    _     |    =     |    {     |    }     |   |    P     |   LEFT   |   DOWN   |    UP    |  RIGHT   |          |
            // |   LSFT/% | +/C+ALT  |    &     |    *     |    [     |    ]     |   | CTL+SPC  |          |          |          |          |          |
            // ---------------------------------|          |          |          |   |          |          |          |---------------------------------
            //                                  ----------------------------------   ----------------------------------
            bindings = <
            // ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                 &kp EXCL         CTME             &kp TILDE        &kp HASH         &kp LPAR         &kp RPAR             &kp T            &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp CARET
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 &kp AT           CTSH             &kp UNDER        &kp EQUAL        &kp LBRC         &kp RBRC             &kp P            &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        ___
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 LSHPRCNT         CTAL             &kp AMPS         &kp ASTRK        &kp LBKT         &kp RBKT             &kp LC(SPACE)    XXX              XXX              XXX              XXX              XXX
            // ╰──────────────────────────────────────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼──────────────────────────────────────────────────╯
                                                                    ___              ___              ___                  ___              ___              ___
            //                                                    ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
            >;
        };

        num_layer {
            display-name = "NUM";
            // -------------------------------------------------------------------   -------------------------------------------------------------------
            // |          |          |          |          |          |          |   |   KP*    |   KP7    |   KP8    |   KP9    |   CALC   |          |
            // |          |   LGUI   |   LALT   |   LSFT   |   LCTL   |          |   |   KP/    |   KP4    |   KP5    |   KP6    |   KP,    |  KP_ENT  |
            // |          |          |          |          |          |          |   |   KP-    |   KP1    |   KP2    |   KP3    |   KP.    |          |
            // ---------------------------------|          |          |          |   |   KP0    |          |   KP+    |---------------------------------
            //                                  ----------------------------------   ----------------------------------
            bindings = <
            // ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                 ___              XXX              XXX              XXX              XXX              XXX                  &kp KP_MULTIPLY  &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp C_AL_CALC    XXX
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 ___              &kp LGUI         &kp LALT         &kp LSHIFT       &kp LCTRL        XXX                  &kp KP_DIVIDE    &kp KP_N4        &kp KP_N5        &kp KP_N6        &kp KP_COMMA     &kp KP_ENTER
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 ___              XXX              XXX              XXX              XXX              XXX                  &kp KP_MINUS     &kp KP_N1        &kp KP_N2        &kp KP_N3        &kp KP_DOT       ___
            // ╰──────────────────────────────────────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼──────────────────────────────────────────────────╯
                                                                    ___              ___              ___                  &kp KP_N0        ___              &kp KP_PLUS
            //                                                    ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
            >;
        };

        fun_layer {
            display-name = "FUN";
            // -------------------------------------------------------------------   -------------------------------------------------------------------
            // |          |   F12    |    F7    |    F8    |    F9    |  PSCRN   |   |          |          |          |          |          |          |
            // |          |   F11    |    F4    |    F5    |    F6    |          |   |          |   RCTL   |   RSFT   |   RALT   |   RGUI   |          |
            // |          |   F10    |    F1    |    F2    |    F3    |          |   |          |          |          |          |          |          |
            // ---------------------------------|          |          |          |   |          |          |          |---------------------------------
            //                                  ----------------------------------   ----------------------------------
            bindings = <
            // ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                 ___              &kp F12          &kp F7           &kp F8           &kp F9           &kp PSCRN            XXX              XXX              XXX              XXX              XXX              XXX
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 ___              &kp F11          &kp F4           &kp F5           &kp F6           XXX                  XXX              &kp RCTRL        &kp RSHIFT       &kp RALT         &kp RGUI         XXX
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 ___              &kp F10          &kp F1           &kp F2           &kp F3           XXX                  XXX              XXX              XXX              XXX              XXX              XXX
            // ╰──────────────────────────────────────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼──────────────────────────────────────────────────╯
                                                                    ___              ___              ___                  ___              ___              ___
            //                                                    ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            // -------------------------------------------------------------------   -------------------------------------------------------------------
            // |    F1    |    F2    |    F3    |    F4    |    F5    |    F6    |   |    F7    |    F8    |    F9    |   F10    |   F11    |   F12    |
            // |   BT0    |   BT1    |   BT2    |   BT3    |   BT4    |  BT_CLR  |   |   RGB-   |   RGB+   |   SAT-   |   SAT+   |  EFFECT  |  TOGGLE  |
            // |   RST    |   BOOT   |  Studio  |   USB    |   BLE    | OUT_TOG  |   |   BOOT   |   RST    |   BRI+   |   BRI-   |  TOGGLE  |          |
            // ---------------------------------|          |          |          |   |          |          |          |---------------------------------
            //                                  ----------------------------------   ----------------------------------
            bindings = <
            // ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮   ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
                 &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6               &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR           &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG
            // ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
                 &sys_reset       &bootloader      &studio_unlock   &out OUT_USB     &out OUT_BLE     &out OUT_TOG         &bootloader      &sys_reset       &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  XXX
            // ╰──────────────────────────────────────────────────┼────────────────┼────────────────┼────────────────┤   ├────────────────┼────────────────┼────────────────┼──────────────────────────────────────────────────╯
                                                                    ___              ___              ___                  ___              ___              ___
            //                                                    ╰────────────────┴────────────────┴────────────────╯   ╰────────────────┴────────────────┴────────────────╯
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                            ___ ___ ___   ___ ___ ___
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                            ___ ___ ___   ___ ___ ___
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                            ___ ___ ___   ___ ___ ___
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                            ___ ___ ___   ___ ___ ___
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                ___ ___ ___ ___ ___ ___   ___ ___ ___ ___ ___ ___
                            ___ ___ ___   ___ ___ ___
            >;
        };
    };
};
