#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Port of the QMK keymap in qmk-template/keymap.c to the 42-key Piantor Pro BT.
 *
 * - The QMK number row is not present and is not emulated. Digits live on the
 *   SYM_EXT layer's keypad.
 * - The QMK STD/gaming and POINTER layers are dropped (no pointing device).
 * - QMK layer names: QWERTY -> BASE, SYMB -> SYM, SYMB_EXT -> SYM_EXT,
 *   ADJUST -> ADJUST (merged with the ZMK bluetooth/RGB/system keys).
 * - QMK custom macros (ASC_*, SEL*, M_*, DM_*) are not ported; their positions
 *   are &none.
 *
 * Timing from qmk-template/config.h:
 *   TAPPING_TERM 200   -> tapping-term-ms = <200>
 *   FLOW_TAP_TERM 150  -> require-prior-idle-ms = <150>
 *   QUICK_TAP_TERM 200 -> quick-tap-ms = <200>
 *   PERMISSIVE_HOLD    -> flavor = "balanced"
 *   CHORDAL_HOLD       -> hold-trigger-key-positions + hold-trigger-on-release
 *   SPECULATIVE_HOLD   -> hold-while-undecided (Shift/Ctrl home-row mods only)
 */

#define BASE 0
#define SYM 1
#define SYM_EXT 2
#define ADJUST 3

/* Key positions per hand, including the thumb keys. */
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        /* Home-row mods, left hand. Hold triggers only on the opposite hand. */
        hml_ag: hml_ag {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Shift/Ctrl home-row mods also use QMK SPECULATIVE_HOLD. */
        hml_sc: hml_sc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Home-row mods, right hand. Hold triggers only on the opposite hand. */
        hmr_ag: hmr_ag {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr_sc: hmr_sc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* QMK G/H -> SYMB layer-taps. */
        hml_lt: hml_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&mo>, <&kp>;
        };

        hmr_lt: hmr_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
            bindings = <&mo>, <&kp>;
        };

        /*
         * Thumb layer-taps. No positional restriction: ADJUST is only reachable
         * from one thumb and must work with both hands, and the SYM/SYM_EXT
         * thumbs should work with the same-hand keys as well.
         */
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        /* QMK CTME/CTSH/CTAL: combined-modifier holds, keycode taps. */
        mm: multi_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // -----------------------------------------------------------------------------------------
            // | ESC  |   Q   |   W   |    E    |    R    |   T   |   Y   |    U    |    I    |   O   |    P    | BSPC |
            // | TAB  |GUI/A  |ALT/S  |SFT/D    |CTL/F    |SYM/G  |SYM/H  |CTL/J    |SFT/K    |ALT/L  |GUI/;    |CTL/' |
            // | LSFT |   Z   |   X   |    C    |    V    |   B   |   N   |    M    |    ,    |   .   |    /    |SFT/\ |
            //                              |  CTL  |SYM/BSPC|EXT/DEL|EXT/ENT |SYM/SPC|ADJ/RCTL|
            bindings = <
                &kp ESC    &kp Q          &kp W           &kp E           &kp R          &kp T         &kp Y          &kp U          &kp I          &kp O          &kp P            &kp BSPC
                &kp TAB    &hml_ag LGUI A &hml_ag LALT S  &hml_sc LSHIFT D &hml_sc LCTRL F &hml_lt SYM G &hmr_lt SYM H  &hmr_sc RCTRL J &hmr_sc RSHIFT K &hmr_ag RALT L &hmr_ag RGUI SEMI &hmr_sc RCTRL SQT
                &kp LSHIFT &kp Z          &kp X           &kp C           &kp V          &kp B         &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH         &hmr_sc RSHIFT BSLH
                &kp LCTRL &tlt SYM BSPC &tlt SYM_EXT DEL &tlt SYM_EXT RET &tlt SYM SPACE &tlt ADJUST RCTRL
            >;
        };

        sym_layer {
            display-name = "SYMB";
            // -----------------------------------------------------------------------------------------
            // |      |CTL+GUI|   ~   |   #   |   (   |   )   |   T   |  HOME   |  PGDN   |  PGUP   |   END   |  F12  |
            // |      |CTL+SFT|-/KP   |   _   |   =   |   {   |   }   |   P   |  LEFT   |  DOWN   |   UP    |  RIGHT  |       |
            // |      |CTL+ALT|+/KP   |   &   |   *   |   [   |   ]   |CTL+SPC|         |         |         |         |       |
            //                              |       |       |       |       |       |       |
            bindings = <
                &trans   &mm LC(LG(LCTRL)) TILDE &kp TILDE &kp HASH     &kp LPAR  &kp RPAR       &kp T         &kp HOME       &kp PG_DN      &kp PG_UP      &kp END        &kp F12
                &trans   &mm LC(LS(LCTRL)) KP_MINUS &kp UNDER &kp EQUAL &kp LBRC  &kp RBRC       &kp P         &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
                &trans   &mm LC(LA(LCTRL)) KP_PLUS  &kp AMPS  &kp ASTRK &kp LBKT  &kp RBKT       &kp LC(SPACE) &none          &none          &none          &none          &none
                &trans &trans &trans &trans &trans &trans
            >;
        };

        sym_ext_layer {
            display-name = "SYM EXT";
            // -----------------------------------------------------------------------------------------
            // |      |CTL+Y  |CTL+X  |CTL+C  |CTL+V  |CTL+Z  |  KP*  |  KP7  |  KP8  |  KP9  | CALC  |       |
            // |      |CTL+SFT|  ENT  |  SPC  | BSPC  |  DEL  |  KP/  |  KP4  |  KP5  |  KP6  |  KP,  |KPEnter|
            // |      |CTL+ALT|       |       |       |       |  KP-  |  KP1  |  KP2  |  KP3  |  KP.  |       |
            //                        |       |       |       |  KP0  |       |  KP+  |
            bindings = <
                &trans   &kp LC(Y)                   &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(Z)   &kp KP_MULTIPLY &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp C_AL_CALC &none
                &trans   &mm LC(LS(LCTRL)) KP_MINUS  &kp RET   &kp SPACE &kp BSPC  &kp DEL     &kp KP_DIVIDE   &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_COMMA  &kp KP_ENTER
                &trans   &mm LC(LA(LCTRL)) KP_PLUS   &none     &none     &none     &none       &kp KP_MINUS    &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT    &trans
                &trans &trans &trans &kp KP_N0 &trans &kp KP_PLUS
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            // -----------------------------------------------------------------------------------------
            // |  F1  |  F2   |  F3   |  F4   |  F5   |  F6   |  F7   |   F8    |   F9    |  F10    |   F11   |  F12  |
            // | BT0  |  BT1  |  BT2  |  BT3  |  BT4  |BT_CLR | RGB-  |  RGB+   |  SAT-   |  SAT+   | EFFECT  | TOGGLE|
            // | RST  | BOOT  |Studio |USB    |BLE    |OUT_TOG| BOOT  |  RST    |  BRI+   |  BRI-   | TOGGLE  |       |
            //                              |       |       |       |       |       |       |
            bindings = <
                &kp F1         &kp F2         &kp F3          &kp F4           &kp F5           &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11          &kp F12
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR      &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF  &rgb_ug RGB_TOG
                &sys_reset     &bootloader    &studio_unlock  &out OUT_USB     &out OUT_BLE     &out OUT_TOG    &bootloader     &sys_reset      &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_TOG  &none
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
